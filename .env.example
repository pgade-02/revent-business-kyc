# Environment variable names used by this app. Names only, never values.
# Copy to .env.local and fill in locally.

# Signs the session cookie. At least 32 random characters, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Optional. Folder for the local PGlite database. Default: .data/pglite
DATABASE_DIR=
