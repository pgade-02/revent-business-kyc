# Environment variable names used by this app. Names only, never values.
# Copy to .env.local and fill in locally.

# Signs the session cookie. At least 32 random characters, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Optional. Folder for the local PGlite database. Default: .data/pglite
DATABASE_DIR=

# Optional. Folder for uploaded files in development. Default: .data/files
FILE_STORE_DIR=

# AI provider (src/config/ai.ts). Without a key, the app uses stand-ins: photos and
# scans show "Uploaded" for review. Use a paid account with training on your data
# switched off (SECURITY §2). Never commit a real key.
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=
MISTRAL_LLM_MODEL=
OCR_TIMEOUT_MS=

# Optional upload safety and readability limits (src/config/limits.ts).
# Defaults: 10 MB, 30 pages, 5 bits, 20 chars per page, 20 chars per document, 500 px, 6000 ms.
UPLOAD_MAX_BYTES=
UPLOAD_MAX_PAGES=
UPLOAD_NEAR_DUPLICATE_MAX_BITS=
READ_MIN_PAGE_TEXT_CHARS=
READ_MIN_DOCUMENT_TEXT_CHARS=
READ_MIN_IMAGE_SIDE_PX=
LLM_TIMEOUT_MS=
